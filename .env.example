# Application
APP_ENV=development
APP_NAME="VED Electrical Services"
APP_DEBUG=true

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api

# Frontend
FRONTEND_URL=http://localhost:5173

# MySQL / SQLAlchemy (XAMPP-friendly local example)
# Keep any blank local-development password only in the ignored .env file.
DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/ved_electrical

# OAuth 2.0 / OpenID Connect
OAUTH_PROVIDER=change_me
OAUTH_CLIENT_ID=change_me
OAUTH_CLIENT_SECRET=change_me
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
OAUTH_DISCOVERY_URL=change_me
OAUTH_SCOPES=openid profile email

# Application Session
SESSION_SECRET=change_me

# File Storage
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
DETECTION_DIR=storage/detections
PREVIEW_DIR=storage/previews
REPORT_DIR=storage/reports

# Upload Configuration
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# AI / YOLO
YOLO_MODEL_PATH=models/yolo/electrical-symbols.pt
YOLO_CONFIDENCE_THRESHOLD=0.50

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
